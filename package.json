{
  "name": "laikn",
  "displayName": "Laikn",
  "description": "Carbon-aware suggestions for compute tasks. Currently in continuous development and open to suggestions!",
  "version": "0.0.5",
  "publisher": "DominicCloutier",
  "repository": {
    "type": "git",
    "url": "https://github.com/DominicCl/Laikn.git"
  },
  "icon": "resources/laikn-icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "laikn.eco-route",
        "title": "Laikn: Eco-Route"
      }
    ],
    "configuration": {
      "title": "Laikn Settings",
      "properties": {
        "laikn.dashboardUrl": {
          "type": "string",
          "default": "https://laikn-dashboard-819883251321.us-central1.run.app",
          "description": "The URL of your Laikn Carbon Analytics Dashboard."
        }
      }
    },
    "icons": {
      "laikn-logo": {
        "description": "Custom Laikn Logo",
        "default": {
          "fontPath": "./resources/laikn.woff",
          "fontCharacter": "\\e900"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src"
  },
  "dependencies": {
    "axios": "^1.7.9"
  }
}